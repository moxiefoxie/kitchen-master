# Public URL of the deployed Strapi Cloud project, without a trailing slash.
STRAPI_URL=https://your-project.strapiapp.com

# Create a read-only API token in Strapi and add it to Vercel. Never expose it
# through a NEXT_PUBLIC_ variable.
STRAPI_API_TOKEN=replace-with-read-only-token
STRAPI_PREVIEW_SECRET=replace-with-a-long-random-secret
