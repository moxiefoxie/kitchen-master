# Public URL of the deployed Strapi Cloud project, without a trailing slash.
STRAPI_URL=https://devoted-angel-d525a2a640.strapiapp.com

# The public-content route currently uses auth: false, so no API token is
# required. If that route is made private later, use a server-only token.
# STRAPI_API_TOKEN=replace-with-read-only-token
STRAPI_PREVIEW_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://www.kitchenmasterbistro.com

# Receives multipart career applications. The server adds the Strapi-managed
# locationName and hiringEmail fields after validating the submitted location.
HIRING_WEBHOOK_URL=https://example.com/your-hiring-workflow

# Receives contact, private-dining, and franchise forms. The server resolves
# recipientEmail from the corresponding Strapi location or site settings.
INQUIRY_WEBHOOK_URL=https://example.com/your-inquiry-workflow

# Preferred email delivery: when these are present, forms are sent directly
# through Resend instead of the webhook fallbacks above.
RESEND_API_KEY=re_replace_with_a_full_access_resend_api_key
EMAIL_FROM=Kitchen Master Website <website@updates.kitchenmasterbistro.com>

# The main Resend Segment used for Kitchen Master Insiders signups.
INSIDERS_SEGMENT_ID=replace-with-resend-segment-id

# Optional per-location Resend Segments for targeted campaigns. This must be a
# single-line JSON object; omit any location that does not need its own segment.
INSIDERS_LOCATION_SEGMENTS={"suwanee":"segment-id","frisco":"segment-id","southlake":"segment-id","midtown":"segment-id"}

# Optional legacy fallback for Insiders signups when Resend is not configured.
INSIDERS_WEBHOOK_URL=https://example.com/your-insiders-workflow
